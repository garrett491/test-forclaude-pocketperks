---
import type { GalleryItem } from '../lib/types';
import { imageUrl } from '../lib/format';

interface Props { items: GalleryItem[]; businessName: string; }
const { items, businessName } = Astro.props;
if (!items.length) return new Response(null, { status: 200 });
---

<section class="gallery" aria-labelledby="gallery-title">
  <h2 id="gallery-title">Photos</h2>
  <ul class="gallery-strip list-plain" data-gallery>
    {items.map((item, index) => (
      <li>
        <button class="shot" type="button"
                data-gallery-open data-index={index}
                data-full={imageUrl(item.media)}
                data-caption={item.caption ?? ''}
                aria-label={`Open photo ${index + 1} of ${items.length} from ${businessName}`}>
          <img src={imageUrl(item.media)}
               alt={item.media?.alt_text || item.caption || `${businessName} photo ${index + 1}`}
               width={item.media?.width ?? 600} height={item.media?.height ?? 450}
               loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
        </button>
        {item.caption && <p class="caption">{item.caption}</p>}
      </li>
    ))}
  </ul>
</section>

{/* Opened only on click, so nothing here costs anything until it is used. */}
<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <button class="lb-close" type="button" data-lightbox-close aria-label="Close photo">×</button>
  <button class="lb-nav lb-prev" type="button" data-lightbox-prev aria-label="Previous photo">‹</button>
  <img data-lightbox-image src="" alt="" />
  <p class="lb-caption" data-lightbox-caption></p>
  <button class="lb-nav lb-next" type="button" data-lightbox-next aria-label="Next photo">›</button>
</dialog>

<style>
  .gallery h2 { font-size: var(--pp-text-xl); margin-bottom: var(--pp-space-3); }

  /*
    A horizontal strip rather than a grid. On a phone a grid of nine photos
    is a wall you have to scroll past to reach the deals; a strip shows the
    same photos, takes one row, and swipes.
  */
  .gallery-strip {
    display: grid; gap: var(--pp-space-3);
    grid-auto-flow: column; grid-auto-columns: minmax(13rem, 1fr);
    overflow-x: auto; scroll-snap-type: x proximity;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--pp-space-4));
    padding-inline: var(--pp-space-4); padding-bottom: var(--pp-space-2);
  }
  .gallery-strip::-webkit-scrollbar { display: none; }
  .gallery-strip > li { scroll-snap-align: start; }

  @media (min-width: 48rem) {
    .gallery-strip {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
      overflow: visible; margin-inline: 0; padding-inline: 0;
    }
  }

  .shot {
    display: block; width: 100%; padding: 0; cursor: zoom-in;
    border: 1px solid var(--pp-line); border-radius: var(--pp-radius-inset);
    overflow: hidden; background: var(--pp-surface);
  }
  .shot img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .shot:hover { border-color: var(--pp-accent); }
  .caption { font-size: var(--pp-text-xs); color: var(--pp-muted); margin: var(--pp-space-2) 0 0; }

  .lightbox {
    border: 0; padding: 0; max-width: 100vw; max-height: 100vh;
    width: 100%; height: 100%; background: rgba(6, 14, 34, 0.94);
  }
  .lightbox::backdrop { background: rgba(6, 14, 34, 0.94); }
  .lightbox img {
    max-width: 92vw; max-height: 78vh; margin: auto;
    object-fit: contain; border-radius: var(--pp-radius-inset);
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lb-caption {
    color: #fff; text-align: center; font-size: var(--pp-text-sm);
    margin: var(--pp-space-3) auto 0; max-width: 40rem; padding-inline: var(--pp-space-4);
  }
  .lb-close, .lb-nav {
    position: fixed; z-index: 2; cursor: pointer;
    width: 52px; height: 52px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.14); color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 1.6rem; line-height: 1;
  }
  .lb-close:hover, .lb-nav:hover { background: rgba(255, 255, 255, 0.28); }
  .lb-close { top: var(--pp-space-4); right: var(--pp-space-4); }
  .lb-prev { left: var(--pp-space-3); top: 50%; transform: translateY(-50%); }
  .lb-next { right: var(--pp-space-3); top: 50%; transform: translateY(-50%); }
  .lightbox :focus-visible { outline: 3px solid var(--pp-lime-300); outline-offset: 2px; }
</style>
