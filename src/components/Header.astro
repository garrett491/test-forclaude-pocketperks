---
import type { NavItem, ContentBlock, SiteSettings, Town } from '../lib/types';
import type { Branding } from '../lib/branding';
import type { TownContext } from '../lib/location';
import LocationPicker from './LocationPicker.astro';

interface Props {
  nav: NavItem[];
  settings: SiteSettings;
  blocks: Record<string, ContentBlock>;
  branding: Branding;
  towns: Town[];
  townContext: TownContext;
}
const { nav, blocks, branding, towns, townContext } = Astro.props;

const headerNav = nav.filter((n) => n.location === 'header');
const path = Astro.url.pathname;

const announcement = blocks['site.announcement'];
const announceText = announcement?.payload?.text as string | undefined;
const announceHref = announcement?.payload?.href as string | undefined;

const showPicker = towns.length > 1;
---

{announceText && (
  <div class="announce">
    <div class="wrap announce-inner">
      {announceHref
        ? <a href={announceHref}>{announceText}</a>
        : <span>{announceText}</span>}
    </div>
  </div>
)}

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="Pocket Perks, home">
      <img src={branding.logo} alt="" width="150" height="34" fetchpriority="high" />
    </a>

    <nav aria-label="Main">
      <ul class="nav-list list-plain">
        {headerNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href.split('#')[0] && !item.href.includes('#') ? 'page' : undefined}
              target={item.opens_new_tab ? '_blank' : undefined}
              rel={item.opens_new_tab ? 'noopener noreferrer' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-action">
      {showPicker ? (
        <LocationPicker context={townContext} />
      ) : (
        <a href="/deals" class="btn btn-primary btn-sm">Find a deal</a>
      )}
    </div>
  </div>
</header>

<style>
  /* The announcement bar is content, so it is editable and schedulable from
     the dashboard rather than hardcoded. It renders only when there is
     something to say — an empty bar is worse than no bar. */
  .announce {
    background: var(--pp-footer-bg);
    color: var(--pp-footer-text);
    font-size: var(--pp-text-sm);
    text-align: center;
  }
  .announce-inner { padding-block: var(--pp-space-2); }
  .announce a { color: var(--pp-lime-300); font-weight: 600; }

  /* Sticky on larger screens, where there is height to spare. On a phone
     the header scrolls away with the page, because a sticky two-row header
     would permanently cover an eighth of the screen. */
  .site-header {
    position: relative; z-index: 20;
    background: var(--pp-header-bg);
    border-bottom: 1px solid var(--pp-line);
  }
  @media (min-width: 48rem) {
    .site-header {
      position: sticky; top: 0;
      background: color-mix(in srgb, var(--pp-header-bg) 94%, transparent);
      backdrop-filter: blur(8px);
    }
  }

  /* Phone: logo and town on the first row, the navigation on its own full
     row beneath, so every item is visible — none hide off the edge. */
  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'brand action' 'nav nav';
    align-items: center; column-gap: var(--pp-space-3);
    padding-block: var(--pp-space-2) 0;
  }
  @media (min-width: 48rem) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav action';
      min-height: 64px; padding-block: 0;
    }
  }
  .brand { grid-area: brand; display: flex; align-items: center; min-height: var(--pp-tap-min); }
  .brand img { width: auto; height: 30px; max-width: 170px; object-fit: contain; }
  .header-action { grid-area: action; justify-self: end; min-width: 0; }

  nav { grid-area: nav; min-width: 0; }
  .nav-list { display: flex; gap: var(--pp-space-1); flex-wrap: wrap; }
  @media (max-width: 47.99rem) {
    .nav-list { justify-content: space-between; border-top: 1px solid var(--pp-line); margin-top: var(--pp-space-2); }
    .nav-list li { flex: 1; }
    .nav-list a { justify-content: center; width: 100%; }
  }
  .nav-list a {
    display: inline-flex; align-items: center;
    min-height: var(--pp-tap-min);
    padding-inline: var(--pp-space-3);
    border-radius: var(--pp-radius-inset);
    color: var(--pp-header-text); text-decoration: none;
    font-size: var(--pp-text-sm); font-weight: 600; white-space: nowrap;
  }
  .nav-list a:hover { background: var(--pp-deep-050); color: var(--pp-link); }
  .nav-list a[aria-current='page'] {
    color: var(--pp-link);
    box-shadow: inset 0 -3px 0 var(--pp-accent);
    border-radius: 0;
  }

  @media (max-width: 22rem) {
    .brand img { height: 26px; max-width: 110px; }
    .nav-list a { padding-inline: var(--pp-space-2); }
  }
</style>
