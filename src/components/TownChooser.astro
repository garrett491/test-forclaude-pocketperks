---
import type { Town, ContentBlock } from '../lib/types';

/**
 * The first thing a first-time visitor sees when Pocket Perks covers more
 * than one town: one question, and the answers as large buttons.
 *
 * Not a popup, not a gate over other content — it IS the page, because
 * which town someone is in decides everything else they will see. Choosing
 * is remembered on this device (a cookie holding only the town's name),
 * and can be changed at any time from the header. No location is requested.
 */
interface Props {
  towns: Town[];
  counts: Map<string, number>;
  block?: ContentBlock;
  hero?: Record<string, string>;
}
const { towns, counts, block, hero } = Astro.props;
const p = (block?.payload ?? {}) as Record<string, string>;
const headline = p.headline || 'Where do you want to find deals?';
const body = p.body || 'Pick your town. We’ll remember it on this device, and you can change it any time.';
---

<section class="chooser" aria-labelledby="chooser-title">
  <div class="wrap chooser-inner">
    {hero?.headline && <p class="chooser-eyebrow">{hero.headline}</p>}
    <h1 id="chooser-title">{headline}</h1>
    <p class="chooser-body">{body}</p>

    <ul class="town-choices list-plain">
      {towns.map((t) => {
        const n = counts.get(t.id) ?? 0;
        return (
          <li>
            <a class="town-choice" href={`/${t.slug}`} data-town-choice data-town-slug={t.slug}>
              <span class="tc-pin" aria-hidden="true">📍</span>
              <span class="tc-text">
                <span class="tc-name">{t.name}, {t.state_code}</span>
                <span class="tc-count">{n === 0 ? 'Businesses being added' : `${n} ${n === 1 ? 'deal' : 'deals'}`}</span>
              </span>
              <span class="tc-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ul>

    <p class="chooser-alt">
      <a href="/?town=all" data-town-choice data-town-slug="all">Or see deals from every town</a>
    </p>
  </div>
</section>

<style>
  .chooser { background: var(--pp-deep); color: var(--pp-white); border-bottom: var(--pp-stitch); }
  .chooser-inner { padding-block: var(--pp-space-6) var(--pp-space-7); max-width: 40rem; }
  .chooser-eyebrow {
    margin: 0 0 var(--pp-space-2); color: var(--pp-lime-300);
    font-size: var(--pp-text-sm); font-weight: 700;
  }
  .chooser h1 { color: var(--pp-white); margin-bottom: var(--pp-space-2); }
  .chooser-body { color: rgba(255, 255, 255, 0.88); margin-bottom: var(--pp-space-5); }

  .town-choices { display: flex; flex-direction: column; gap: var(--pp-space-3); }
  .town-choice {
    display: flex; align-items: center; gap: var(--pp-space-3);
    min-height: 64px; padding: var(--pp-space-3) var(--pp-space-4);
    background: var(--pp-surface); color: var(--pp-text);
    border-left: var(--pp-stitch);
    border-radius: var(--pp-radius-inset);
    text-decoration: none; box-shadow: var(--pp-shadow-card);
    transition: box-shadow var(--pp-duration) var(--pp-ease), transform var(--pp-duration) var(--pp-ease);
  }
  .town-choice:hover { box-shadow: var(--pp-shadow-lift); color: var(--pp-text); }
  .town-choice:active { transform: translateY(1px); }
  .town-choice:focus-visible { outline-color: var(--pp-lime-300); }
  .tc-pin { font-size: 1.2rem; }
  .tc-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .tc-name {
    font-family: var(--pp-font-display); font-weight: 700;
    font-size: var(--pp-text-xl); line-height: 1.15; color: var(--pp-heading);
  }
  .tc-count { font-size: var(--pp-text-sm); color: var(--pp-muted); }
  .tc-arrow {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--pp-action-bg); color: var(--pp-action-text); font-weight: 700;
  }
  .chooser-alt { margin: var(--pp-space-4) 0 0; }
  .chooser-alt a {
    color: var(--pp-white); font-weight: 600; font-size: var(--pp-text-sm);
    display: inline-flex; align-items: center; min-height: var(--pp-tap-min);
  }
  .chooser-alt a:hover { color: var(--pp-lime-300); }
</style>
