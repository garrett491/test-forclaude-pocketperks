---
import type { Deal } from '../lib/types';
import MediaFrame from './MediaFrame.astro';
import { expiryLabel, isEndingSoon, isNew, truncate } from '../lib/format';

/**
 * One deal, for lists of a single business's offers (its own page, and
 * "more from this business" on a deal page). Everywhere businesses are
 * listed side by side, BusinessCard is used instead.
 */
interface Props { deal: Deal; priority?: boolean; showMerchant?: boolean; headingLevel?: 'h2' | 'h3'; }
const { deal, priority = false, showMerchant = true, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

const merchant = deal.merchant!;
const href = `/b/${merchant.slug}/${deal.slug}`;
const expiry = expiryLabel(deal);

/**
 * The deal's own image, then the business photo, then the logo. A logo
 * stands on white with padding; a photo on a quiet neutral. Either way the
 * whole image shows — a flyer's prices and dates are never cut off.
 */
const art = deal.image ?? merchant.cover ?? merchant.logo;
const artIsLogo = !deal.image && !merchant.cover && !!merchant.logo;

/** At most one badge: two badges compete and neither is read. */
const badge = deal.badge
  ? { label: deal.badge.label, style: deal.badge.style_key }
  : isEndingSoon(deal)
    ? null
    : isNew(deal)
      ? { label: 'New', style: 'lime' as const }
      : null;
---

<article class="deal-card card" data-deal-id={deal.id} data-merchant-id={merchant.id} data-track-impression>
  <div class="art">
    <MediaFrame
      asset={art} mode="box" ratio={16 / 10} kind={artIsLogo ? 'logo' : 'photo'}
      alt={deal.image ? (deal.image.alt_text || deal.headline) : ''}
      name={merchant.name} width={640} priority={priority}
      sizes="(min-width: 75rem) 360px, (min-width: 48rem) 45vw, 94vw"
    />
    {badge && <span class={`badge badge-${badge.style} art-badge`}>{badge.label}</span>}
  </div>

  <div class="body">
    {showMerchant && (
      <p class="merchant-line">
        <span class="merchant-name">{merchant.name}</span>
        {merchant.category && <span class="dot" aria-hidden="true"></span>}
        {merchant.category && <span class="cat">{merchant.category.name}</span>}
      </p>
    )}

    <Heading class="headline">
      <a href={href} class="stretch">{deal.headline}</a>
    </Heading>

    {deal.description && <p class="desc">{truncate(deal.description, 110)}</p>}
    {deal.restrictions && <p class="limits">{deal.restrictions}</p>}

    {deal.coupon_code && (
      <div class="stitch-panel code-panel">
        <span class="code-label">Code</span>
        <span class="code-value">{deal.coupon_code}</span>
      </div>
    )}

    <div class="meta">
      {expiry && <span class:list={['expiry', { 'is-soon': isEndingSoon(deal) }]}>{expiry}</span>}
      <span class="see" aria-hidden="true">See deal →</span>
    </div>
  </div>
</article>

<style>
  .deal-card { position: relative; }
  .art { position: relative; }
  .art-badge { position: absolute; top: var(--pp-space-3); left: var(--pp-space-3); z-index: 2; }

  .body {
    padding: var(--pp-space-4);
    display: flex; flex-direction: column; gap: var(--pp-space-2);
    flex: 1;
  }
  .merchant-line {
    display: flex; align-items: center; gap: var(--pp-space-2);
    margin: 0; font-size: var(--pp-text-xs); color: var(--pp-muted);
  }
  .merchant-name { font-weight: 600; color: var(--pp-green); }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: currentColor; opacity: 0.5; }

  .headline { font-size: var(--pp-text-lg); margin: 0; }
  .headline a { color: var(--pp-text); text-decoration: none; }
  .headline a:hover { color: var(--pp-green); text-decoration: underline; }

  .desc { font-size: var(--pp-text-sm); color: var(--pp-muted); margin: 0; }
  .limits { font-size: var(--pp-text-xs); color: var(--pp-muted); margin: 0; font-weight: 600; }

  .code-panel { display: flex; align-items: baseline; gap: var(--pp-space-2); margin: var(--pp-space-1) 0 0; }
  .code-label {
    font-size: var(--pp-text-xs); text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--pp-muted); font-weight: 600;
  }
  .code-value { font-family: var(--pp-font-display); font-size: var(--pp-text-lg); color: var(--pp-green); font-weight: 700; }

  .meta {
    margin-top: auto; padding-top: var(--pp-space-2);
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--pp-space-3); font-size: var(--pp-text-xs);
  }
  .expiry { color: var(--pp-muted); font-weight: 600; }
  .expiry.is-soon { color: var(--pp-text); }
  .see { color: var(--pp-green); font-weight: 700; margin-left: auto; }
  .deal-card:hover .see { text-decoration: underline; }
</style>
