---
import type { Merchant } from '../lib/types';
import MediaFrame from './MediaFrame.astro';
import { cardDeals, moreDealsLabel } from '../lib/listing';
import { expiryLabel } from '../lib/format';

/**
 * The featured-business carousel.
 *
 * A continuous, slow drift that loops without ever visibly resetting, with
 * a plain-language "Pause slideshow" control beneath it. Paused, arrows
 * appear beside the control; swiping works on touch screens. Anyone whose
 * device asks for reduced motion gets a still strip with arrows instead.
 *
 * All of the behaviour lives in site.js. This file is the markup, and the
 * markup works on its own: without JavaScript the strip is a horizontally
 * scrollable row of ordinary links.
 *
 * Every slide is the same size whatever shape its image is, so the strip
 * never changes height and never stutters as differently shaped images
 * pass through it.
 */
interface Props {
  merchants: Merchant[];
  townName?: string | null;
  /** Seconds for one card to pass. Set in admin Settings. */
  seconds?: number;
  autoplay?: boolean;
}

const { merchants, townName, seconds = 8, autoplay = true } = Astro.props;
if (!merchants.length) return;

const title = `Featured businesses${townName ? ` in ${townName}` : ''}`;
---

<section class="carousel" aria-labelledby="carousel-title" aria-roledescription="carousel"
         data-carousel data-seconds={String(seconds)} data-autoplay={String(autoplay)}>
  <div class="wrap">
    <h2 id="carousel-title" class="carousel-title">{title}</h2>
  </div>

  <div class="track-wrap" data-carousel-viewport>
    <ul class="track list-plain" data-carousel-track>
      {merchants.map((merchant, index) => {
        const { shown, more } = cardDeals(merchant.deals);
        const top = shown[0];
        const art = merchant.cover ?? merchant.logo ?? null;
        const artIsLogo = !merchant.cover && !!merchant.logo;
        const expiry = top ? expiryLabel(top) : null;
        return (
          <li class="slide" data-slide aria-roledescription="slide"
              aria-label={`${index + 1} of ${merchants.length}: ${merchant.name}`}
              {...(top ? { 'data-track-impression': '', 'data-deal-id': top.id, 'data-merchant-id': merchant.id } : {})}>
            <a class="slide-link" href={`/b/${merchant.slug}`} draggable="false">
              <MediaFrame
                asset={art} mode="box" ratio={16 / 10} kind={artIsLogo ? 'logo' : 'photo'}
                alt="" name={merchant.name} width={640} priority={index === 0}
                sizes="(min-width: 40rem) 360px, 80vw" class="slide-art"
              />
              <div class="slide-body">
                <p class="slide-merchant">{merchant.name}</p>
                <p class="slide-headline">{top ? top.headline : (merchant.tagline ?? 'See what they offer')}</p>
                <p class="slide-meta">
                  {more > 0 && <span class="slide-more">{moreDealsLabel(more)}</span>}
                  {more === 0 && shown.length > 1 && <span class="slide-more">{shown.length} deals</span>}
                  {expiry && <span class="slide-expiry">{expiry}</span>}
                  <span class="slide-cta">View business <span aria-hidden="true">→</span></span>
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>

  {/* Below the strip, where a thumb already is on a phone. Spelled out in
      words, because two vertical bars mean nothing to a lot of people. The
      script reveals these; without it, they would be controls that do nothing. */}
  <div class="wrap">
    <div class="carousel-controls" data-carousel-controls hidden>
      <button class="nav-btn" type="button" data-carousel-prev aria-label="Previous business" hidden>
        <span aria-hidden="true">‹</span>
      </button>
      <button class="pause-btn" type="button" data-carousel-pause>
        <span class="pause-icon" aria-hidden="true" data-pause-icon>❚❚</span>
        <span data-pause-label>Pause slideshow</span>
      </button>
      <button class="nav-btn" type="button" data-carousel-next aria-label="Next business" hidden>
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </div>
</section>

<style>
  .carousel {
    background: var(--pp-deep);
    padding-block: var(--pp-space-5) var(--pp-space-4);
    border-block: var(--pp-stitch);
  }
  .carousel-title { color: var(--pp-white); margin: 0 0 var(--pp-space-4); font-size: var(--pp-text-xl); }

  /* Without JavaScript: a plain scrollable row. With it, the script takes
     over the movement and the overflow is hidden. */
  .track-wrap { position: relative; overflow-x: auto; scrollbar-width: none; }
  .track-wrap::-webkit-scrollbar { display: none; }
  .track-wrap.is-enhanced { overflow: hidden; touch-action: pan-y; }

  .track {
    display: flex; gap: var(--pp-space-4);
    align-items: stretch;
    width: max-content;
    padding-inline: max(var(--pp-space-4), calc((100vw - 1180px) / 2 + var(--pp-space-4)));
    padding-block: var(--pp-space-1) var(--pp-space-3);
  }
  /* The drift runs on the compositor: no repaint of the page beneath it,
     and no fighting the main thread while someone scrolls. */
  .track.is-moving { will-change: transform; }

  .slide {
    /* Sized so the next card peeks in on a phone. That overhang is what
       tells a thumb there is more to the right. */
    flex: 0 0 min(22rem, 78vw);
    display: flex;
    background: var(--pp-surface);
    border-radius: var(--pp-radius-card);
    overflow: hidden;
    box-shadow: var(--pp-shadow-lift);
  }
  .slide-link {
    display: flex; flex-direction: column; flex: 1;
    color: var(--pp-text); text-decoration: none;
    -webkit-user-drag: none; user-select: none;
  }
  .slide-link:focus-visible { outline-offset: -4px; }

  .slide-body {
    padding: var(--pp-space-3) var(--pp-space-4) var(--pp-space-4);
    display: flex; flex-direction: column; gap: var(--pp-space-1);
    flex: 1;
  }
  .slide-merchant {
    margin: 0; font-size: var(--pp-text-sm); font-weight: 700; color: var(--pp-green);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  /* Two lines, always: every slide is the same height whatever it says. */
  .slide-headline {
    margin: 0; font-family: var(--pp-font-display);
    font-size: var(--pp-text-lg); line-height: var(--pp-leading-tight);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    min-height: calc(2em * var(--pp-leading-tight));
  }
  .slide-meta {
    margin: auto 0 0; padding-top: var(--pp-space-2);
    display: flex; gap: var(--pp-space-3); align-items: center; flex-wrap: wrap;
    font-size: var(--pp-text-xs);
  }
  .slide-more { font-weight: 700; color: var(--pp-text); background: var(--pp-lime-100); padding: 0.15em 0.6em; border-radius: var(--pp-radius-chip); }
  .slide-expiry { color: var(--pp-muted); font-weight: 600; }
  .slide-cta { color: var(--pp-green); font-weight: 700; margin-left: auto; }
  .slide:hover .slide-cta { text-decoration: underline; }

  .carousel-controls {
    display: flex; gap: var(--pp-space-3); align-items: center; justify-content: center;
    padding-top: var(--pp-space-2);
  }
  /* The hidden attribute must win over the display rules below, or a
     control the script has hidden stays on screen doing nothing. */
  .carousel [hidden] { display: none !important; }
  .pause-btn {
    display: inline-flex; align-items: center; gap: var(--pp-space-2);
    min-height: var(--pp-tap-min); padding-inline: var(--pp-space-4);
    background: transparent; color: var(--pp-white);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: var(--pp-radius-chip);
    font-size: var(--pp-text-sm); font-weight: 600; cursor: pointer;
  }
  .pause-btn:hover { background: rgba(255, 255, 255, 0.12); border-color: var(--pp-accent); }
  .pause-icon { font-size: 0.75em; letter-spacing: -0.1em; }
  .nav-btn {
    width: var(--pp-tap-min); height: var(--pp-tap-min);
    display: grid; place-items: center;
    border-radius: 50%; cursor: pointer;
    background: var(--pp-surface); color: var(--pp-ink);
    border: 0; font-size: 1.5rem; line-height: 1;
  }
  .nav-btn:hover { background: var(--pp-lime-300); }

  .carousel :global(:focus-visible) { outline-color: var(--pp-lime-300); }
</style>
