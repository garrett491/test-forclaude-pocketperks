---
import type { Merchant } from '../lib/types';
import { imageUrl, imageSrcSet, initials, openStatus, truncate } from '../lib/format';

interface Props {
  merchant: Merchant;
  priority?: boolean;
  /** Shown instead of the deal count, e.g. for businesses with none live. */
  note?: string;
}
const { merchant, priority = false, note } = Astro.props;

const href = `/b/${merchant.slug}`;
const status = openStatus(merchant.hours);
const dealCount = merchant.deals?.length ?? 0;
const logo = merchant.logo ?? merchant.cover;
---

<article class="merchant-card card" data-merchant-id={merchant.id} data-track-impression
         data-search-text={`${merchant.name} ${merchant.tagline ?? ''} ${merchant.category?.name ?? ''}`}>
  <div class="head">
    <div class="logo">
      {logo ? (
        <img
          src={imageUrl(logo, 120)}
          srcset={imageSrcSet(logo, 120)}
          alt={logo.alt_text || merchant.name}
          width="60" height="60"
          loading={priority ? 'eager' : 'lazy'} decoding="async"
        />
      ) : (
        <span class="logo-fallback" aria-hidden="true">{initials(merchant.name)}</span>
      )}
    </div>

    <div class="head-text">
      <h3 class="name"><a href={href} class="stretch">{merchant.name}</a></h3>
      {merchant.category && <p class="cat">{merchant.category.name}</p>}
    </div>
  </div>

  {merchant.tagline && <p class="tagline">{truncate(merchant.tagline, 90)}</p>}

  <div class="meta">
    {status && (
      <span class={`status ${status.isOpen ? 'is-open' : ''}`}>{status.label}</span>
    )}
    {note && <span class="note">{note}</span>}
  </div>

  {/* Soft variant: the whole card already leads here, so the job of this
      band is to say how much is waiting, not to offer a second destination. */}
  {!note && dealCount > 0 && (
    <a class="more-band more-band-soft" href={`/b/${merchant.slug}`}>
      <span class="mb-text">
        See {dealCount} {dealCount === 1 ? 'deal' : 'deals'} from {merchant.name}
      </span>
      <span class="mb-arrow" aria-hidden="true">→</span>
    </a>
  )}
</article>

<style>
  .merchant-card { position: relative; padding: var(--pp-space-4); gap: var(--pp-space-3); }
  .head { display: flex; gap: var(--pp-space-3); align-items: center; }
  .logo {
    width: 68px; height: 68px; flex-shrink: 0;
    border-radius: var(--pp-radius-inset); overflow: hidden;
    /* White, not the green wash: merchant logos are almost always drawn for
       a white background, and a tinted tile puts a halo around every
       transparent PNG. */
    background: var(--pp-white);
    border: 1px solid var(--pp-line);
    display: grid; place-items: center;
  }
  /* contain, not cover: a logo cropped to fill its box is a broken logo,
     and merchant logos are the content here. The padding matters as much as
     the fit — a wide wordmark touching both edges looks cut off. */
  .logo img { width: 100%; height: 100%; object-fit: contain; padding: 7px; }
  .logo-fallback {
    font-family: var(--pp-font-display); font-size: 1.4rem;
    color: var(--pp-white); background: var(--pp-deep);
    width: 100%; height: 100%; display: grid; place-items: center;
  }
  .head-text { min-width: 0; }
  .name { font-size: var(--pp-text-lg); margin: 0; }
  .name a { color: var(--pp-text); text-decoration: none; }
  .name a:hover { color: var(--pp-green); text-decoration: underline; }
  .stretch::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .cat { font-size: var(--pp-text-xs); color: var(--pp-muted); margin: 0.15rem 0 0; }
  .tagline { font-size: var(--pp-text-sm); color: var(--pp-muted); margin: 0; }
  .meta {
    display: flex; gap: var(--pp-space-3); flex-wrap: wrap;
    margin-top: auto; font-size: var(--pp-text-xs); font-weight: 600;
  }
  .status { color: var(--pp-muted); }
  .status.is-open { color: var(--pp-green); }
  .note { color: var(--pp-muted); font-weight: 600; }
  .meta:empty { display: none; }
</style>
