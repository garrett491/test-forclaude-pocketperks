---
import Base from '../../../layouts/Base.astro';
import DealCard from '../../../components/DealCard.astro';
import BusinessCard from '../../../components/BusinessCard.astro';
import Gallery from '../../../components/Gallery.astro';
import MediaFrame from '../../../components/MediaFrame.astro';
import EmptyState from '../../../components/EmptyState.astro';
import SignupBox from '../../../components/SignupBox.astro';
import ServiceNotice from '../../../components/ServiceNotice.astro';
import { getMerchant, getRelatedMerchants, getSiteChrome } from '../../../lib/queries';
import { cachePublic, markUnavailable } from '../../../lib/http';
import { logDataError } from '../../../lib/errors';
import {
  imageUrl, openStatus, groupedHours, telHref, directionsHref, formatAddress, displayUrl, dayName,
} from '../../../lib/format';
import type { Merchant } from '../../../lib/types';

/**
 * A business page, e.g. /b/crossroads-pizza.
 *
 * Three outcomes, kept strictly apart:
 *   found        the page, cached for a minute
 *   not found    a real 404 — only when the database says it does not exist
 *   unavailable  a "try again" page, 503, never cached
 *
 * These used to collapse into one: any failure looked like "not found", and
 * a component on this page aborted the response mid-stream whenever the
 * business had no gallery photos, leaving a half-drawn page.
 */
const { merchant: slug } = Astro.params;
const { blocks } = await getSiteChrome(Astro.locals);

let merchant: Merchant | null = null;
let related: Merchant[] = [];
let unavailable = false;

try {
  merchant = await getMerchant(slug!);
} catch (error) {
  logDataError(`business page ${slug}`, error);
  unavailable = true;
}

if (!unavailable && !merchant) return Astro.rewrite('/404');

if (merchant) {
  // Suggestions are a nice-to-have. Their failure never costs the page.
  try { related = await getRelatedMerchants(merchant); } catch { related = []; }
}

if (unavailable) markUnavailable(Astro);
else cachePublic(Astro);

const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? '').replace(/\/$/, '');
const deals = merchant?.deals ?? [];
const status = openStatus(merchant?.hours);
const hours = groupedHours(merchant?.hours);
const address = merchant ? formatAddress(merchant) : null;
const tel = merchant ? telHref(merchant) : null;
const directions = merchant ? directionsHref(merchant) : null;
const socials = merchant ? [merchant.facebook_url, merchant.instagram_url].filter(Boolean) as string[] : [];

/**
 * LocalBusiness structured data, from populated fields only. Inventing a
 * rating or price range we cannot observe would be invalid markup.
 */
const localBusiness: Record<string, unknown> | null = merchant && {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: merchant.name,
  url: `${siteUrl}/b/${merchant.slug}`,
  ...(merchant.description && { description: merchant.description }),
  ...(merchant.phone_e164 && { telephone: merchant.phone_e164 }),
  ...((merchant.website_url || socials.length) && { sameAs: [merchant.website_url, ...socials].filter(Boolean) }),
  ...((merchant.logo || merchant.cover) && { image: imageUrl(merchant.cover ?? merchant.logo) }),
  ...(merchant.address_line1 && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: [merchant.address_line1, merchant.address_line2].filter(Boolean).join(', '),
      addressLocality: merchant.city ?? merchant.town?.name,
      addressRegion: merchant.state_code,
      postalCode: merchant.postal_code,
      addressCountry: 'US',
    },
  }),
  ...(merchant.latitude != null && merchant.longitude != null && {
    geo: { '@type': 'GeoCoordinates', latitude: merchant.latitude, longitude: merchant.longitude },
  }),
  ...(merchant.hours?.some((h) => !h.is_closed && h.opens_at && h.closes_at) && {
    openingHoursSpecification: merchant.hours
      .filter((h) => !h.is_closed && h.opens_at && h.closes_at)
      .map((h) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: `https://schema.org/${dayName(h.day_of_week)}`,
        opens: h.opens_at,
        closes: h.closes_at,
      })),
  }),
  ...(deals.length > 0 && {
    makesOffer: deals.map((d) => ({
      '@type': 'Offer',
      name: d.headline,
      ...(d.description && { description: d.description }),
      ...(d.ends_at && { availabilityEnds: d.ends_at }),
      url: `${siteUrl}/b/${merchant.slug}/${d.slug}`,
    })),
  }),
};

const cover = merchant?.cover ?? null;
const place = merchant?.town ? ` in ${merchant.town.name}, ${merchant.town.state_code}` : '';
---

<Base
  title={merchant ? (merchant.seo_title ?? `${merchant.name} — Deals & Info`) : 'Temporarily unavailable'}
  description={merchant ? (
    merchant.seo_description ??
    merchant.tagline ??
    `${merchant.name}${place}. ${deals.length ? `${deals.length} current ${deals.length === 1 ? 'offer' : 'offers'}, hours, phone and directions.` : 'Hours, phone and directions.'}`
  ) : undefined}
  canonicalPath={`/b/${slug}`}
  signupBox={!merchant}
  ogImage={imageUrl(cover ?? merchant?.logo)}
  noindex={unavailable}
  schema={localBusiness ? [localBusiness] : []}
  breadcrumbs={merchant ? [
    { name: 'Home', href: '/' },
    ...(merchant.town ? [{ name: merchant.town.name, href: `/${merchant.town.slug}` }] : []),
    { name: merchant.name, href: `/b/${merchant.slug}` },
  ] : []}
>
  {unavailable || !merchant ? (
    <ServiceNotice />
  ) : (
  <article class="profile" data-merchant-id={merchant.id} data-track-merchant-view>
    {cover && (
      <div class="cover">
        {/* The whole photo, never cropped: the frame takes the photo's own
            shape, up to a sensible height. */}
        <MediaFrame asset={cover} mode="fit" kind="photo" alt={cover.alt_text || ''}
                    name={merchant.name} width={1600} priority={true} sizes="100vw" />
      </div>
    )}

    <header class="head">
      <div class="wrap head-inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          {merchant.town ? <a href={`/${merchant.town.slug}`}>← Deals in {merchant.town.name}</a> : <a href="/">← All deals</a>}
        </nav>

        <div class="identity">
          <MediaFrame asset={merchant.logo} mode="tile" kind="logo" alt={`${merchant.name} logo`}
                      name={merchant.name} width={400} priority={true} class="profile-logo" />

          <div class="identity-text">
            <h1>{merchant.name}</h1>
            <p class="sub">
              {merchant.category && <a href={`/deals?category=${merchant.category.slug}${merchant.town ? `&town=${merchant.town.slug}` : ''}`}>{merchant.category.name}</a>}
              {merchant.category && merchant.town && <span aria-hidden="true"> · </span>}
              {merchant.town && <a href={`/${merchant.town.slug}`}>{merchant.town.name}, {merchant.town.state_code}</a>}
            </p>
            {status && <p class:list={['status', { 'is-open': status.isOpen }]}>{status.label}</p>}
            {merchant.tagline && <p class="tagline">{merchant.tagline}</p>}
          </div>
        </div>

        {/* Ordered by how directly each moves a customer toward the door.
            Every one is a real link that works without JavaScript. */}
        {(tel || directions || merchant.website_url) && (
          <div class="actions">
            {tel && (
              <a class="btn btn-primary" href={tel} data-track="call_click" data-merchant={merchant.id}>
                Call {merchant.phone_display}
              </a>
            )}
            {directions && (
              <a class="btn btn-outline" href={directions} target="_blank" rel="noopener noreferrer"
                 data-track="directions_click" data-merchant={merchant.id}>
                Get directions<span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}
            {merchant.website_url && (
              <a class="btn btn-outline" href={merchant.website_url} target="_blank" rel="noopener noreferrer"
                 data-track="website_click" data-merchant={merchant.id}>
                Visit website<span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="wrap body-grid">
      <div class="main-col">
        <section aria-labelledby="deals-title">
          <h2 id="deals-title">
            {deals.length ? `${deals.length} current ${deals.length === 1 ? 'deal' : 'deals'}` : 'Deals'}
          </h2>
          {deals.length ? (
            <div class="grid deal-grid">
              {deals.map((deal, i) => (
                <DealCard deal={{ ...deal, merchant }} priority={i === 0} showMerchant={false} />
              ))}
            </div>
          ) : (
            <EmptyState headingLevel="h3" block={blocks['empty.merchant_no_deals']}
                        headline="No deal running right now"
                        body="This business is on Pocket Perks but has nothing live today. Their details are below."
                        ctaLabel="" ctaHref="" />
          )}
        </section>

        <div class="signup-under-deals"><SignupBox source="business-page" /></div>

        {/* Photos supplied by the business, not scraped. After the deals,
            because someone landing here came for an offer first. */}
        <Gallery items={merchant.gallery ?? []} businessName={merchant.name} />

        {merchant.description && (
          <section aria-labelledby="about-title" class="about">
            <h2 id="about-title">About {merchant.name}</h2>
            <p>{merchant.description}</p>
          </section>
        )}
      </div>

      <aside class="side-col" aria-labelledby="details-title">
        <div class="info-card card">
          <h2 class="info-title" id="details-title">Details</h2>
          <dl class="info-list">
            {address && (
              <div>
                <dt>Address</dt>
                <dd>
                  {directions ? (
                    <a href={directions} target="_blank" rel="noopener noreferrer"
                       data-track="directions_click" data-merchant={merchant.id}>{address}<span class="sr-only"> (map, opens in a new tab)</span></a>
                  ) : address}
                </dd>
              </div>
            )}
            {tel && (
              <div>
                <dt>Phone</dt>
                <dd><a href={tel} data-track="call_click" data-merchant={merchant.id}>{merchant.phone_display}</a></dd>
              </div>
            )}
            {merchant.website_url && (
              <div>
                <dt>Website</dt>
                <dd>
                  <a href={merchant.website_url} target="_blank" rel="noopener noreferrer"
                     data-track="website_click" data-merchant={merchant.id}>
                    {displayUrl(merchant.website_url)}<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </dd>
              </div>
            )}
            {hours.length > 0 && (
              <div>
                <dt>Hours</dt>
                <dd>
                  <ul class="list-plain hours">
                    {hours.map((line) => <li>{line}</li>)}
                  </ul>
                </dd>
              </div>
            )}
            {socials.length > 0 && (
              <div>
                <dt>Social</dt>
                <dd class="row">
                  {merchant.facebook_url && (
                    <a href={merchant.facebook_url} target="_blank" rel="noopener noreferrer"
                       data-track="website_click" data-merchant={merchant.id}>Facebook<span class="sr-only"> (opens in a new tab)</span></a>
                  )}
                  {merchant.instagram_url && (
                    <a href={merchant.instagram_url} target="_blank" rel="noopener noreferrer"
                       data-track="website_click" data-merchant={merchant.id}>Instagram<span class="sr-only"> (opens in a new tab)</span></a>
                  )}
                </dd>
              </div>
            )}
          </dl>
          <p class="listing-note">
            Listed on Pocket Perks by the business. Offers are set by {merchant.name}; ask them if anything is unclear.
          </p>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="wrap section" aria-labelledby="related-title">
        <h2 id="related-title">More local businesses</h2>
        <div class="grid biz-grid">
          {related.map((m) => <BusinessCard merchant={m} />)}
        </div>
      </section>
    )}
  </article>
  )}
</Base>

<style>
  .signup-under-deals { margin-block: var(--pp-space-6); }
  .cover { background: var(--pp-frame); border-bottom: 1px solid var(--pp-line); }
  .cover :global(.mf-fit) { --mf-max: min(62vh, 28rem); --mf-min: 9rem; max-width: 1180px; margin-inline: auto; }

  .head { background: var(--pp-surface); border-bottom: 1px solid var(--pp-line); }
  .head-inner { padding-block: var(--pp-space-4) var(--pp-space-5); display: flex; flex-direction: column; gap: var(--pp-space-4); }
  .crumbs { font-size: var(--pp-text-sm); font-weight: 600; }
  .crumbs a { display: inline-flex; min-height: var(--pp-tap-min); align-items: center; }

  .identity { display: flex; gap: var(--pp-space-4); align-items: flex-start; flex-wrap: wrap; }
  .identity :global(.profile-logo) { --tile-h: 88px; --tile-max: 220px; box-shadow: var(--pp-shadow-card); }
  .identity-text { min-width: min(100%, 14rem); flex: 1; }
  .identity-text h1 { margin-bottom: var(--pp-space-1); }
  .sub { font-size: var(--pp-text-sm); color: var(--pp-muted); margin: 0 0 var(--pp-space-2); }
  .status { font-size: var(--pp-text-sm); font-weight: 700; color: var(--pp-muted); margin: 0; }
  .status.is-open { color: var(--pp-green); }
  .tagline { margin: var(--pp-space-2) 0 0; color: var(--pp-muted); }

  .actions { display: flex; gap: var(--pp-space-2); flex-wrap: wrap; }
  /* On a phone the actions are a full-width stack: one-thumb reachable. */
  @media (max-width: 30rem) {
    .actions { flex-direction: column; }
    .actions :global(.btn) { width: 100%; min-height: 48px; }
  }

  /* minmax(0, 1fr), not 1fr: a plain 1fr track refuses to shrink below its
     widest content, which is what pushed this page 300px past the edge of
     a phone screen. */
  .body-grid {
    display: grid; gap: var(--pp-space-6);
    grid-template-columns: minmax(0, 1fr);
    padding-block: var(--pp-space-6);
  }
  @media (min-width: 60rem) { .body-grid { grid-template-columns: minmax(0, 1fr) 20rem; } }

  .main-col { display: flex; flex-direction: column; gap: var(--pp-space-6); min-width: 0; }
  .about p { color: var(--pp-muted); }

  .info-card { padding: var(--pp-space-4); gap: var(--pp-space-3); }
  .info-title { font-size: var(--pp-text-lg); margin: 0; }
  .info-list { margin: 0; display: flex; flex-direction: column; gap: var(--pp-space-3); }
  .info-list dt { font-size: var(--pp-text-xs); font-weight: 700; color: var(--pp-muted); letter-spacing: 0.03em; }
  .info-list dd { margin: 0.15rem 0 0; font-size: var(--pp-text-sm); overflow-wrap: anywhere; }
  .info-list dd a { display: inline-block; padding-block: 0.3rem; }
  .hours { display: flex; flex-direction: column; gap: 0.1rem; font-variant-numeric: tabular-nums; }
  .listing-note { font-size: var(--pp-text-xs); color: var(--pp-muted); margin: 0; }
</style>
