  .input.tiny.num-input { max-width: 5rem; text-align: right; }
  .add-form { margin-top: var(--pp-space-5); padding-top: var(--pp-space-4); border-top: 1px solid var(--pp-line); }
  .add-form h3 { font-size: var(--pp-text-base); margin-bottom: var(--pp-space-3); }
  .danger-text { color: var(--pp-danger); }

  .gallery-admin { display: flex; flex-direction: column; gap: var(--pp-space-3); }
  .gallery-admin li {
    display: flex; gap: var(--pp-space-3); align-items: center; flex-wrap: wrap;
    padding: var(--pp-space-3); background: var(--pp-paper);
    border-radius: var(--pp-radius-inset);
  }
