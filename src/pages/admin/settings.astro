---
import Admin from '../../layouts/Admin.astro';
import { str, bool, int, humanError, writeFailure } from '../../lib/admin';
import ImageUpload from '../../components/ImageUpload.astro';

export const prerender = false;

const { db, profile } = Astro.locals;
let error: string | null = null;
let success: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'settings') {
    const updates: { key: string; value: unknown }[] = [];
    for (const [name, val] of form.entries()) {
      if (!name.startsWith('setting.') || typeof val !== 'string') continue;
      const key = name.slice(8);
      const text = val.trim();

      // Settings are stored as real JSON types. Writing "8" where the site
      // expects 8, or "false" where it expects false, silently breaks the
      // reader on the other end.
      let value: unknown = text;
      if (key === 'carousel.seconds_per_slide') {
        value = Math.min(20, Math.max(4, parseInt(text, 10) || 8));
      } else if (text === 'true' || text === 'false') {
        value = text === 'true';
      }
      updates.push({ key, value });
    }

    // URL-shaped settings must be real https links: a bare "facebook.com/x"
    // becomes a broken relative link in the footer.
    for (const { key, value } of updates) {
      if (/_url$/.test(key) && typeof value === 'string' && value && !/^https:\/\/[^\s]+$/i.test(value)) {
        error = `"${key}" must be a full web address starting with https://, or left blank.`;
      }
      if (key === 'contact.email' && typeof value === 'string' && value && !/^[^@\s]+@[^@\s.]+\.[a-z]{2,}$/i.test(value)) {
        error = 'The contact email does not look like an email address.';
      }
    }
    const missing: string[] = [];
    for (const { key, value } of error ? [] : updates) {
      const result = await db
        .from('site_settings').update({ value, updated_by: profile.id }).eq('key', key).select('key');
      if (result.error) { error = humanError(result.error); break; }
      if (!result.data?.length) missing.push(key);
    }
    if (!error && missing.length) {
      error = `Most settings saved, but these do not exist in the database yet: ${missing.join(', ')}. Run the latest migration in Supabase.`;
    }
    if (!error) success = 'Settings saved. The site shows them straight away.';
  }

  if (intent === 'branding') {
    /**
     * Four image slots stored as media ids. An empty value clears the slot
     * and the site falls back to the bundled placeholder, so there is no way
     * to end up with a broken logo.
     */
    for (const slot of ['logo', 'footer_mark', 'favicon', 'og_image']) {
      const key = `branding.${slot}_media_id`;
      const value = str(form, key) ?? '';
      const brandError = writeFailure(await db
        .from('site_settings').update({ value, updated_by: profile.id }).eq('key', key).select('key'));
      if (brandError) { error = brandError; break; }
    }
    if (!error) success = 'Branding saved. The site updates within a minute.';
  }

  if (intent === 'town') {
    const id = str(form, 'town_id');
    const payload = {
      name: str(form, 'name'),
      sort_order: int(form, 'sort_order'),
      is_active: bool(form, 'is_active'),
      seo_title: str(form, 'seo_title'),
      seo_description: str(form, 'seo_description'),
    };
    // The slug is generated by the trigger added in migration 0006. Sending
    // an empty string here is what made "add a town" impossible before.
    if (!payload.name) {
      error = 'Give the town a name.';
    } else {
      const result = id
        ? await db.from('towns').update(payload).eq('id', id).select('id')
        : await db.from('towns').insert({
            ...payload,
            state_code: (str(form, 'state_code') ?? 'OH').toUpperCase(),
          }).select('id');
      error = writeFailure(result);
      if (!error) success = id ? 'Town saved.' : 'Town added.';
    }
  }

  if (intent === 'category') {
    const id = str(form, 'category_id');
    const name = str(form, 'name');
    if (!name) {
      error = 'Give the category a name.';
    } else {
      const payload = {
        name,
        sort_order: int(form, 'sort_order'),
        is_active: bool(form, 'is_active'),
      };
      const result = id
        ? await db.from('categories').update(payload).eq('id', id).select('id')
        : await db.from('categories').insert(payload).select('id');
      error = writeFailure(result);
      if (!error) success = id ? 'Category saved.' : 'Category added.';
    }
  }
}

const [{ data: settingRows }, { data: townRows }, { data: catRows }] = await Promise.all([
  db.from('site_settings').select('*').order('key'),
  db.from('towns').select('*').order('sort_order'),
  db.from('categories').select('*').order('sort_order'),
]);

const settings = (settingRows ?? []) as any[];

const brandingKeys = ['branding.logo_media_id', 'branding.footer_mark_media_id',
                      'branding.favicon_media_id', 'branding.og_image_media_id'];
const brandingIds = brandingKeys
  .map((key) => settings.find((s) => s.key === key)?.value)
  .filter((v): v is string => typeof v === 'string' && v.length > 0);

let brandingAssets: any[] = [];
if (brandingIds.length) {
  const { data } = await db
    .from('media')
    .select('id, bucket_id, storage_path, alt_text, width, height')
    .in('id', brandingIds);
  brandingAssets = data ?? [];
}
const assetFor = (key: string) => {
  const id = settings.find((s) => s.key === key)?.value;
  return brandingAssets.find((a) => a.id === id) ?? null;
};
const towns = (townRows ?? []) as any[];
const categories = (catRows ?? []) as any[];

const get = (key: string) => settings.find((s) => s.key === key);
const raw = (key: string) => {
  const value = get(key)?.value;
  return typeof value === 'string' ? value : value == null ? '' : String(value);
};

const groups = [
  { title: 'Site details', hint: 'Names and contact information shown in the footer and in search results.',
    keys: ['site.name', 'site.tagline', 'contact.email', 'contact.phone_display'] },
  { title: 'Search and sharing', hint: 'Defaults used on any page without its own title or description.',
    keys: ['seo.default_title', 'seo.default_description', 'seo.og_image_path'] },
  { title: 'Social', hint: 'Leave blank to hide the icon from the footer.',
    keys: ['social.facebook_url', 'social.instagram_url'] },
  { title: 'Location', hint: 'How the town picker behaves.',
    keys: ['location.area_name'] },
  { title: 'Internal', hint: 'Never shown on the public site.',
    keys: ['ops.notify_email'] },
];
---

<Admin title="Settings" profile={profile}>
  {success && <p class="form-success" role="status">{success}</p>}
  {error && <p class="form-error" role="alert">{error}</p>}

  <section class="panel">
    <h2>Branding</h2>
    <p class="panel-hint">
      Upload your artwork here rather than replacing files in the code. Until
      a slot is filled the site uses the placeholder that ships with it, so
      nothing ever looks broken.
    </p>

    <form method="post" class="stack">
      <input type="hidden" name="intent" value="branding" />

      <div class="brand-grid">
        <div class="brand-slot">
          <ImageUpload
            name="branding.logo_media_id" label="Header logo" aspect="wide" maxEdge={800}
            current={assetFor('branding.logo_media_id')}
            hint="Shown top-left on every page and on this sign-in screen. A wide lockup works best — roughly 300 by 68."
          />
        </div>

        <div class="brand-slot">
          <ImageUpload
            name="branding.footer_mark_media_id" label="Footer mark" aspect="square" maxEdge={400}
            current={assetFor('branding.footer_mark_media_id')}
            hint="The small mark on the dark green footer. Square, and it needs to read well on a dark background."
          />
        </div>

        <div class="brand-slot">
          <ImageUpload
            name="branding.favicon_media_id" label="Browser tab icon" aspect="square" maxEdge={256}
            current={assetFor('branding.favicon_media_id')}
            hint="Square, and simple — it renders about 16 pixels wide. The pocket on its own beats the full lockup here."
          />
        </div>

        <div class="brand-slot">
          <ImageUpload
            name="branding.og_image_media_id" label="Link preview image" aspect="wide" maxEdge={1200}
            current={assetFor('branding.og_image_media_id')}
            hint="What Facebook shows when someone shares a link. Exactly 1200 by 630. Without it, shared links look broken."
          />
        </div>
      </div>

      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save branding</button>
        <a class="btn btn-ghost" href="/" target="_blank" rel="noopener">Open the site</a>
      </div>
      <p class="hint">
        Two steps per image: choose the file and wait for &ldquo;Uploaded&rdquo;, then press
        Save branding.
      </p>
    </form>
  </section>

  <form method="post" class="stack">
    <input type="hidden" name="intent" value="settings" />

    {groups.map((group) => (
      <section class="panel">
        <h2>{group.title}</h2>
        <p class="panel-hint">{group.hint}</p>
        <div class="form-grid">
          {group.keys.map((key) => {
            const setting = get(key);
            if (!setting) return null;
            return (
              <div class="field">
                <label for={key}>{setting.label}</label>
                {key === 'seo.default_description' ? (
                  <textarea class="input" id={key} name={`setting.${key}`} maxlength="300">{raw(key)}</textarea>
                ) : (
                  <input class="input" id={key} name={`setting.${key}`} value={raw(key)} />
                )}
                {setting.description && <p class="hint">{setting.description}</p>}
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <section class="panel">
      <h2>Carousel</h2>
      <p class="panel-hint">
        The moving strip of featured businesses near the top of each town’s page.
        Choose who appears in it on each business’s page (“Show in the featured
        carousel”). Speed is roughly the seconds each business takes to pass —
        lower is faster.
      </p>
      <div class="form-grid cols-2">
        <div class="field">
          <label for="carousel.seconds_per_slide">Seconds per card</label>
          <input class="input" id="carousel.seconds_per_slide"
                 name="setting.carousel.seconds_per_slide" type="number"
                 min="4" max="20" step="1" value={raw('carousel.seconds_per_slide') || '8'} />
          <p class="hint">
            Between 4 and 20. Eight is a comfortable reading pace; below five
            is hard to read on a phone.
          </p>
        </div>
        <div class="field">
          <label for="carousel.autoplay">Movement</label>
          <select class="input" id="carousel.autoplay" name="setting.carousel.autoplay">
            <option value="true" selected={raw('carousel.autoplay') !== 'false'}>Rotates on its own</option>
            <option value="false" selected={raw('carousel.autoplay') === 'false'}>Still until a visitor uses the arrows</option>
          </select>
          <p class="hint">
            Visitors can always pause it themselves, and anyone who has asked
            their device for reduced motion never sees it move.
          </p>
        </div>
      </div>
    </section>

    {/* The ActiveCampaign switch. Flipping this changes every signup form on
        the site at once, with no deploy. */}
    <section class="panel">
      <h2>Newsletter destination</h2>
      <p class="panel-hint">{get('newsletter.mode')?.description}</p>
      <div class="form-grid cols-2">
        <div class="field">
          <label for="newsletter.mode">Where signups go</label>
          <select class="input" id="newsletter.mode" name="setting.newsletter.mode">
            <option value="supabase" selected={raw('newsletter.mode') === 'supabase'}>
              Store them here in Pocket Perks
            </option>
            <option value="activecampaign_link" selected={raw('newsletter.mode') === 'activecampaign_link'}>
              Send people to an ActiveCampaign form
            </option>
          </select>
        </div>
        <div class="field">
          <label for="newsletter.external_form_url">ActiveCampaign form link</label>
          <input class="input" id="newsletter.external_form_url"
                 name="setting.newsletter.external_form_url" value={raw('newsletter.external_form_url')}
                 placeholder="https://yourpocketperks.activehosted.com/f/1" />
          <p class="hint">Only used when the option above is set to ActiveCampaign.</p>
        </div>
      </div>
      <p class="hint switch-note">
        Export your existing list from the Subscribers page before switching, or
        the addresses collected so far will not follow you across.
      </p>
    </section>

    <div class="form-actions"><button class="btn btn-primary" type="submit">Save settings</button></div>
  </form>

  <section class="panel">
    <h2>Towns</h2>
    <p class="panel-hint">
      Adding a town creates its own page, e.g. /carrollton, which is what local
      searches land on. A town cannot be removed once businesses reference it —
      switch it off instead.
    </p>

    {towns.map((town) => (
      <form method="post" class="row-form">
        <input type="hidden" name="intent" value="town" />
        <input type="hidden" name="town_id" value={town.id} />
        <div class="form-grid cols-2">
          <div class="field">
            <label for={`town-${town.id}`}>Name</label>
            <input class="input" id={`town-${town.id}`} name="name" value={town.name} />
            <p class="hint">/{town.slug}</p>
          </div>
          <div class="field">
            <label for={`town-order-${town.id}`}>Order</label>
            <input class="input" id={`town-order-${town.id}`} name="sort_order" type="number" value={town.sort_order} />
          </div>
          <div class="field span-2">
            <label for={`town-seo-${town.id}`}>Description in Google results</label>
            <textarea class="input" id={`town-seo-${town.id}`} name="seo_description" maxlength="300">{town.seo_description ?? ''}</textarea>
          </div>
          <input type="hidden" name="seo_title" value={town.seo_title ?? ''} />
          <div class="field span-2">
            <label class="switch">
              <input type="checkbox" name="is_active" checked={town.is_active} />
              <span>Active</span>
            </label>
          </div>
        </div>
        <div class="form-actions"><button class="btn btn-outline btn-sm" type="submit">Save {town.name}</button></div>
      </form>
    ))}

    <form method="post" class="add-form">
      <input type="hidden" name="intent" value="town" />
      <h3>Add a town</h3>
      <p class="hint">
        The web address is made from the name automatically — "Malvern" becomes
        <code>/malvern</code>. Once a second town exists, town filters appear on
        the deals and businesses pages by themselves.
      </p>
      <div class="form-grid cols-2">
        <div class="field">
          <label for="new-town-name">Town name</label>
          <input class="input" id="new-town-name" name="name" required maxlength="80" placeholder="Malvern" />
        </div>
        <div class="field">
          <label for="new-town-state">State</label>
          <input class="input" id="new-town-state" name="state_code" value="OH" maxlength="2" pattern="[A-Za-z]{2}" />
        </div>
        <div class="field">
          <label for="new-town-order">Order</label>
          <input class="input" id="new-town-order" name="sort_order" type="number" value="50" />
        </div>
        <div class="field">
          <label class="switch">
            <input type="checkbox" name="is_active" checked />
            <span>Active straight away</span>
          </label>
        </div>
        <div class="field span-2">
          <label for="new-town-seo">Description in Google results</label>
          <textarea class="input" id="new-town-seo" name="seo_description" maxlength="300"
            placeholder="Current coupons and discounts from businesses in Malvern, Ohio."></textarea>
        </div>
        <input type="hidden" name="seo_title" value="" />
      </div>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Add town</button></div>
    </form>
  </section>

  <section class="panel">
    <h2>Categories</h2>
    <p class="panel-hint">
      Rename or reorder these. Categories with no live deals are hidden from the
      site automatically, so an empty one never sends someone to a blank page.
    </p>
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th scope="col">Name</th><th scope="col" class="num">Order</th><th scope="col">Active</th><th scope="col"></th></tr>
        </thead>
        <tbody>
          {categories.map((cat) => (
            <tr>
              <td>
                <form method="post" class="inline-form" id={`cat-${cat.id}`}>
                  <input type="hidden" name="intent" value="category" />
                  <input type="hidden" name="category_id" value={cat.id} />
                  <input class="input tiny" name="name" value={cat.name} aria-label={`Name for ${cat.name}`} />
                </form>
              </td>
              <td class="num">
                <input class="input tiny num-input" form={`cat-${cat.id}`} name="sort_order"
                       type="number" value={cat.sort_order} aria-label={`Order for ${cat.name}`} />
              </td>
              <td>
                <label class="switch">
                  <input type="checkbox" form={`cat-${cat.id}`} name="is_active" checked={cat.is_active} />
                  <span class="sr-only">Active</span>
                </label>
              </td>
              <td><button class="btn btn-outline btn-sm" form={`cat-${cat.id}`} type="submit">Save</button></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <form method="post" class="add-form">
      <input type="hidden" name="intent" value="category" />
      <h3>Add a category</h3>
      <div class="form-grid cols-2">
        <div class="field">
          <label for="new-cat-name">Category name</label>
          <input class="input" id="new-cat-name" name="name" required maxlength="60" placeholder="Pets & Animals" />
          <p class="hint">Name it the way a customer would say it, not the way a directory would file it.</p>
        </div>
        <div class="field">
          <label for="new-cat-order">Order</label>
          <input class="input" id="new-cat-order" name="sort_order" type="number" value="80" />
        </div>
        <div class="field span-2">
          <label class="switch">
            <input type="checkbox" name="is_active" checked />
            <span>Active</span>
          </label>
        </div>
      </div>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Add category</button></div>
    </form>
  </section>

  <section class="panel">
    <h2>Administrators</h2>
    <p class="panel-hint">
      Admin accounts are created in the Supabase dashboard, not here. That is
      deliberate: if this session were ever stolen, whoever had it still could
      not create a second administrator.
    </p>
    <p class="who-note">Signed in as <strong>{profile.display_name}</strong> ({profile.email}) · {profile.role}</p>
  </section>
</Admin>

<style>
  .row-form { padding-top: var(--pp-space-4); border-top: 1px solid var(--pp-line); margin-top: var(--pp-space-4); }
  .row-form:first-of-type { border-top: 0; padding-top: 0; margin-top: 0; }
  .inline-form { display: inline; }
  .input.tiny { min-height: 34px; padding: 0.2rem 0.55rem; border-radius: var(--pp-radius-inset); font-size: var(--pp-text-sm); min-width: 9rem; }
  .input.tiny.num-input { min-width: 4.5rem; text-align: right; }
  .switch-note { margin-top: var(--pp-space-3); }
  .who-note { font-size: var(--pp-text-sm); color: var(--pp-muted); margin: 0; }
  .brand-grid { display: grid; gap: var(--pp-space-5); grid-template-columns: 1fr; }
  @media (min-width: 48rem) { .brand-grid { grid-template-columns: 1fr 1fr; } }
  .brand-slot {
    padding: var(--pp-space-4); background: var(--pp-paper);
    border-radius: var(--pp-radius-inset);
  }
  .add-form {
    margin-top: var(--pp-space-5); padding-top: var(--pp-space-4);
    border-top: 1px solid var(--pp-line);
  }
  .add-form h3 { font-size: var(--pp-text-base); margin-bottom: var(--pp-space-2); }
  .add-form code {
    background: var(--pp-deep-050); padding: 0.1em 0.35em;
    border-radius: 4px; font-size: 0.92em;
  }
</style>
