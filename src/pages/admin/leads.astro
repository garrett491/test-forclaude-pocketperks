---
import Admin from '../../layouts/Admin.astro';
import { str, writeFailure } from '../../lib/admin';

export const prerender = false;

const { db, profile } = Astro.locals;
let error: string | null = null;
let success: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = str(form, 'id');
  const status = String(form.get('status') ?? '');
  const notes = str(form, 'admin_notes');

  if (id && ['new', 'contacted', 'won', 'lost'].includes(status)) {
    error = writeFailure(await db
      .from('merchant_leads').update({ status, admin_notes: notes }).eq('id', id).select('id'));
    if (!error) success = 'Enquiry updated.';
  } else {
    error = 'That update was not valid.';
  }
}

const filter = Astro.url.searchParams.get('status') ?? 'open';

let request = db
  .from('merchant_leads')
  .select('id, business_name, contact_name, phone, email, town_text, message, status, admin_notes, created_at')
  .order('created_at', { ascending: false });

if (filter === 'open') request = request.in('status', ['new', 'contacted']);
else if (filter !== 'all') request = request.eq('status', filter);

const { data } = await request;
const leads = (data ?? []) as any[];

const filters = [
  { key: 'open', label: 'Open' },
  { key: 'new', label: 'New' },
  { key: 'contacted', label: 'Contacted' },
  { key: 'won', label: 'Won' },
  { key: 'lost', label: 'Lost' },
  { key: 'all', label: 'All' },
];

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Admin title="Business enquiries" profile={profile}>
  {success && <p class="form-success" role="status">{success}</p>}
  {error && <p class="form-error" role="alert">{error}</p>}

  <div class="chip-row" role="group" aria-label="Filter enquiries">
    {filters.map((f) => (
      <a class="chip" href={`/admin/leads?status=${f.key}`}
         aria-current={filter === f.key ? 'true' : undefined}>{f.label}</a>
    ))}
  </div>

  {leads.length === 0 ? (
    <div class="panel"><p class="empty-row">Nothing here. New enquiries from the site land in this list.</p></div>
  ) : (
    <div class="lead-list">
      {leads.map((lead) => (
        <article class="panel lead">
          <header class="lead-head">
            <div>
              <h2>{lead.business_name}</h2>
              <p class="lead-meta">
                {lead.contact_name} · {lead.town_text ?? 'no town given'} · {fmt(lead.created_at)}
              </p>
            </div>
            <span class={`pill pill-${lead.status === 'won' ? 'active' : lead.status === 'lost' ? 'archived' : 'draft'}`}>
              {lead.status}
            </span>
          </header>

          <div class="lead-contact row">
            <a href={`tel:${String(lead.phone).replace(/[^0-9+]/g, '')}`}>{lead.phone}</a>
            <a href={`mailto:${lead.email}`}>{lead.email}</a>
          </div>

          {lead.message && <p class="lead-message">{lead.message}</p>}

          <form method="post" class="lead-form">
            <input type="hidden" name="id" value={lead.id} />
            <div class="field">
              <label class="sr-only" for={`notes-${lead.id}`}>Notes</label>
              <input class="input" id={`notes-${lead.id}`} name="admin_notes"
                     value={lead.admin_notes ?? ''} placeholder="Notes — called 9/2, sending plan sheet" />
            </div>
            <div class="field">
              <label class="sr-only" for={`status-${lead.id}`}>Status</label>
              <select class="input" id={`status-${lead.id}`} name="status">
                <option value="new" selected={lead.status === 'new'}>New</option>
                <option value="contacted" selected={lead.status === 'contacted'}>Contacted</option>
                <option value="won" selected={lead.status === 'won'}>Won</option>
                <option value="lost" selected={lead.status === 'lost'}>Lost</option>
              </select>
            </div>
            <button class="btn btn-outline btn-sm" type="submit">Update</button>
          </form>
        </article>
      ))}
    </div>
  )}
</Admin>

<style>
  .chip-row { margin-bottom: var(--pp-space-4); }
  .lead-list { display: flex; flex-direction: column; gap: var(--pp-space-4); }
  .lead-head { display: flex; justify-content: space-between; gap: var(--pp-space-3); align-items: flex-start; }
  .lead-head h2 { margin: 0; font-size: var(--pp-text-lg); }
  .lead-meta { font-size: var(--pp-text-sm); color: var(--pp-muted); margin: 0.2rem 0 0; }
  .lead-contact { margin-top: var(--pp-space-3); font-size: var(--pp-text-sm); font-weight: 600; }
  .lead-message {
    margin: var(--pp-space-3) 0 0; font-size: var(--pp-text-sm); color: var(--pp-muted);
    border-left: var(--pp-stitch); padding-left: var(--pp-space-4); max-width: none;
  }
  .lead-form {
    display: grid; gap: var(--pp-space-2); margin-top: var(--pp-space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .lead-form { grid-template-columns: 1fr 11rem auto; align-items: end; } }
</style>
