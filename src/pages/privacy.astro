---
import Base from '../layouts/Base.astro';
import { getSiteChrome, CACHE_STATIC } from '../lib/queries';
Astro.response.headers.set('Cache-Control', CACHE_STATIC);
const { settings } = await getSiteChrome();
const email = settings['contact.email'] as string | undefined;
const updated = 'September 2026';
---

<Base title="Privacy" description="What Pocket Perks collects, why, and how to remove it."
      canonicalPath="/privacy"
      breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Privacy', href: '/privacy' }]}>
  <div class="wrap section prose">
    <h1>Privacy</h1>
    <p class="muted">Last updated {updated}.</p>

    <h2>What we collect</h2>
    <p>
      If you join the email list, we store your address, the date, and which page
      you signed up from. That is the only personal information we ask for.
    </p>

    <h2>What we measure</h2>
    <p>
      We count how often deals are seen and how often people tap Call, Directions,
      a website link, or a coupon code. This is what we show the businesses that
      pay to be listed, so they can see whether it is working.
    </p>
    <p>
      We do not store your IP address. To avoid counting the same person twice in
      a day, we create a one-way scrambled code from your connection and browser.
      The recipe for that code changes every day, so the code cannot be used to
      follow you from one day to the next, and it cannot be turned back into
      anything that identifies you.
    </p>
    <p>We do not use advertising trackers, and we do not sell or share your data.</p>

    <h2>Cookies</h2>
    <p>
      Pocket Perks does not set advertising or analytics cookies. Anything the
      site remembers stays in your own browser.
    </p>

    <h2>Getting removed</h2>
    <p>
      Every email has an unsubscribe link. You can also write to us and we will
      delete your address.
    </p>
    {email && <p><a href={`mailto:${email}?subject=Privacy%20request`}>{email}</a></p>}
  </div>
</Base>

<style>
  .prose { max-width: 44rem; }
  .prose h2 { font-size: var(--pp-text-xl); margin-top: var(--pp-space-6); }
  .prose p { color: var(--pp-muted); }
</style>
