---
import Base from '../layouts/Base.astro';
import TownView from '../components/TownView.astro';
import ServiceNotice from '../components/ServiceNotice.astro';
import { getSiteChrome, getTowns, getTownPageData, type TownPageData } from '../lib/queries';
import { cachePublic, markUnavailable } from '../lib/http';
import { isDataUnavailable, logDataError } from '../lib/errors';
import type { Town } from '../lib/types';

/**
 * A town's landing page, e.g. /carrollton.
 *
 * The page most likely to rank for "deals in carrollton ohio", and a stable
 * link to share. It is the same view as the homepage once that town is
 * chosen, with the town in the heading, and visiting it remembers the town.
 */
const { town: slug } = Astro.params;
const { settings, blocks } = await getSiteChrome(Astro.locals);

let towns: Town[] = [];
let town: Town | null = null;
let data: TownPageData | null = null;
let unavailable = false;

try {
  towns = await getTowns(Astro.locals);
  town = towns.find((t) => t.slug === slug) ?? null;
  if (town) data = await getTownPageData(town.slug);
} catch (error) {
  if (!isDataUnavailable(error)) logDataError('town page', error);
  unavailable = true;
}

// Only a town that truly does not exist is a 404. A database hiccup is a
// "try again" page, and is never cached as if the town had vanished.
if (!unavailable && !town) return Astro.rewrite('/404');

if (unavailable) markUnavailable(Astro);
else cachePublic(Astro, { varyByTown: false });

const place = town ? `${town.name}, ${town.state_code}` : '';
const businessCount = data ? data.cards.length + data.quiet.length : 0;
---

<Base
  pathTownSlug={town?.slug}
  title={town?.seo_title ?? `Local Deals in ${place || 'your town'}`}
  description={
    town?.seo_description ??
    `Current coupons and discounts from ${businessCount} ${businessCount === 1 ? 'business' : 'businesses'} in ${place}. Free to use, no signup.`
  }
  canonicalPath={`/${slug}`}
  noindex={unavailable}
  signupBox={unavailable || !data}
  breadcrumbs={town ? [{ name: 'Home', href: '/' }, { name: town.name, href: `/${town.slug}` }] : []}
>
  {unavailable || !data ? (
    <ServiceNotice />
  ) : (
    <TownView
      town={town}
      towns={towns}
      data={data}
      settings={settings}
      blocks={blocks}
      heading={`Deals in ${place}`}
    />
  )}
</Base>
