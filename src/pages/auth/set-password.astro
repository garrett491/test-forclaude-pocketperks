---
import AuthCard from '../../layouts/AuthCard.astro';
import { getAuthClient } from '../../lib/admin';
import { safeNext } from '../../lib/portal';

export const prerender = false;

/**
 * Choosing a password: the end of a "forgot your password" email, and the
 * first step for a new business login.
 *
 * The link arrives in one of two forms. A link made from the admin
 * ("Business logins") carries ?token_hash=; a reset email sent by Supabase
 * carries ?code=. Either is exchanged here for a session, then the page
 * reloads without it, so the one-time token never sits in the address bar
 * or the browser history.
 */
const params = Astro.url.searchParams;
const next = safeNext(params.get('next'));
const db = getAuthClient(Astro.cookies, Astro.request);
const here = `/auth/set-password?next=${encodeURIComponent(next)}`;
const signInPage = next.startsWith('/admin') ? '/admin/login' : '/portal/login';

let error: string | null = null;

if (Astro.request.method === 'GET' && (params.get('token_hash') || params.get('code'))) {
  const tokenHash = params.get('token_hash');
  const result = tokenHash
    ? await db.auth.verifyOtp({ token_hash: tokenHash, type: (params.get('type') as 'recovery' | 'invite') || 'recovery' })
    : await db.auth.exchangeCodeForSession(params.get('code')!);
  if (result.error) {
    error = 'This link has expired or was already used.';
  } else {
    return Astro.redirect(here, 303);
  }
}

const { data: userData } = await db.auth.getUser();
const user = userData?.user ?? null;

if (Astro.request.method === 'POST' && user) {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password.length < 8) {
    error = 'Use at least 8 characters.';
  } else if (password !== confirm) {
    error = 'The two passwords are different. Type the same one twice.';
  } else {
    const { error: updateError } = await db.auth.updateUser({ password });
    if (updateError) {
      error = /same/i.test(updateError.message)
        ? 'That is your current password. Choose a new one.'
        : /weak|short|characters/i.test(updateError.message)
          ? 'That password is too easy to guess. Try a longer one.'
          : 'The password could not be saved. Try again.';
    } else {
      return Astro.redirect(next, 303);
    }
  }
}
---

<AuthCard title="Choose a password" eyebrow={next.startsWith('/admin') ? 'Admin' : 'Business login'}>
  {error && <p class="form-error" role="alert">{error}</p>}

  {user ? (
    <form method="post" class="stack">
      <p class="note">Signed in as <strong>{user.email}</strong>.</p>
      <div class="field">
        <label for="password">New password</label>
        <input class="input" id="password" name="password" type="password"
               autocomplete="new-password" minlength="8" required autofocus />
        <p class="hint">At least 8 characters. A short sentence is easy to remember and hard to guess.</p>
      </div>
      <div class="field">
        <label for="confirm">Type it again</label>
        <input class="input" id="confirm" name="confirm" type="password"
               autocomplete="new-password" minlength="8" required />
      </div>
      <button class="btn btn-primary btn-block" type="submit">Save password</button>
    </form>
  ) : (
    <>
      {!error && <p>This page opens from the link in your email.</p>}
      <p class="note">
        {next.startsWith('/admin')
          ? 'Go back to the sign-in page and press “Forgot your password?” for a new link.'
          : 'Go back to the sign-in page and press “Forgot your password?”, or ask Pocket Perks to send a new link.'}
      </p>
      <a class="btn btn-outline btn-block" href={signInPage}>Back to sign in</a>
    </>
  )}
</AuthCard>
