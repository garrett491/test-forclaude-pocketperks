---
import Base from '../layouts/Base.astro';
import TownChooser from '../components/TownChooser.astro';
import TownView from '../components/TownView.astro';
import ServiceNotice from '../components/ServiceNotice.astro';
import { getSiteChrome, getTowns, getTownPageData, getTownDealCounts, type TownPageData } from '../lib/queries';
import { resolveTownContext } from '../lib/location';
import { cachePublic, markUnavailable } from '../lib/http';
import { logDataError } from '../lib/errors';
import type { Town } from '../lib/types';

/**
 * The homepage.
 *
 * With more than one town, a first-time visitor is asked one question —
 * which town? — and the answer is remembered on their device. Everyone
 * else goes straight to their town's deals, on this same URL, with no
 * redirect in between. With a single town there is nothing to ask, so its
 * deals show immediately.
 */

const { settings, blocks, ok: chromeOk } = await getSiteChrome(Astro.locals);
const hero = blocks['home.hero']?.payload as Record<string, string> | undefined;

let towns: Town[] = [];
let data: TownPageData | null = null;
let counts = new Map<string, number>();
let unavailable = !chromeOk;
let choosing = false;
let town: Town | null = null;

if (!unavailable) {
  try {
    towns = await getTowns(Astro.locals);
    const context = resolveTownContext(Astro.url, Astro.cookies, towns);
    choosing = towns.length > 1 && context.isDefault;
    town = context.showingAll ? null : context.town;
    if (choosing) counts = await getTownDealCounts();
    else data = await getTownPageData(town?.slug);
  } catch (error) {
    logDataError('homepage', error);
    unavailable = true;
  }
}

if (unavailable) markUnavailable(Astro);
else cachePublic(Astro, { varyByTown: towns.length > 1 });

const title = (settings['seo.default_title'] as string) || 'Pocket Perks — Local Deals Near You';
---

<Base
  title={title}
  description={settings['seo.default_description'] as string}
  canonicalPath="/"
>
  {unavailable ? (
    <ServiceNotice />
  ) : choosing ? (
    <TownChooser towns={towns} counts={counts} block={blocks['home.town_chooser']} hero={hero} />
  ) : data && (
    <TownView
      town={town}
      towns={towns}
      data={data}
      settings={settings}
      blocks={blocks}
      heading={hero?.headline || 'Save money at the places you already go'}
      subheading={hero?.subheadline || 'Free local coupons from businesses near you. No app, no signup.'}
    />
  )}
</Base>
