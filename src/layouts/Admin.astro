---
import '../styles/global.css';
import '../styles/admin.css';
import type { AdminProfile } from '../lib/admin';

interface Props {
  title: string;
  profile: AdminProfile;
  /** Rendered to the right of the page heading. */
  actions?: boolean;
}

const { title, profile } = Astro.props;
const path = Astro.url.pathname;

const sections = [
  { label: 'Dashboard',   href: '/admin' },
  { label: 'Businesses',  href: '/admin/merchants' },
  { label: 'Deals',       href: '/admin/deals' },
  { label: 'Approvals',   href: '/admin/approvals' },
  { label: 'Reports',     href: '/admin/reports' },
  { label: 'Subscribers', href: '/admin/subscribers' },
  { label: 'Enquiries',   href: '/admin/leads' },
  { label: 'Business logins', href: '/admin/business-logins' },
  { label: 'Site content',href: '/admin/content' },
  { label: 'Design',      href: '/admin/design' },
  { label: 'Settings',    href: '/admin/settings' },
];

const isCurrent = (href: string) =>
  href === '/admin' ? path === '/admin' : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Pocket Perks admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Fonts come from global.css, served by this site: nothing is requested from Google. -->
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#admin-main">Skip to content</a>

    <header class="admin-topbar">
      <a href="/admin" class="admin-brand">
        <img src="/logo.svg" alt="Pocket Perks" width="132" height="30" />
        <span class="admin-tag">Admin</span>
      </a>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">View site</a>
        <span class="admin-who">{profile.display_name}</span>
        <form method="post" action="/admin/logout">
          <button class="btn btn-outline btn-sm" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <div class="admin-shell">
      <nav class="admin-nav" aria-label="Admin sections">
        <ul class="list-plain">
          {sections.map((s) => (
            <li>
              <a href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>{s.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <main id="admin-main" class="admin-main">
        <div class="admin-head">
          <h1>{title}</h1>
          <slot name="actions" />
        </div>
        <slot />
      </main>
    </div>
    <script src="../scripts/admin.js"></script>
  </body>
</html>
