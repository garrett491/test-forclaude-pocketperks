---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SignupBox from '../components/SignupBox.astro';
import { getSiteChrome, getTownsSafe } from '../lib/queries';
import { resolveTheme, themeCss, fontHref } from '../lib/theme';
import { getBranding } from '../lib/branding';
import { resolveTownContext } from '../lib/location';
// The same files global.css loads, so a preload is never a wasted download.
import bodyFont from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import headingFont from '@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Path only, e.g. "/b/crossroads-pizza". Resolved against the site URL. */
  canonicalPath?: string;
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** JSON-LD objects. Only emit markup describing what is actually on the page. */
  schema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
  /** Set by town pages so the header agrees with the page being viewed. */
  pathTownSlug?: string;
  /** The outlined email signup above the footer. Off where the page places its own. */
  signupBox?: boolean;
}

const {
  title, description, canonicalPath, ogImage,
  ogType = 'website', noindex = false, schema = [], breadcrumbs = [], pathTownSlug, signupBox = true,
} = Astro.props;

// Both are shared with the page through Astro.locals, so asking for them
// here costs nothing extra. Neither throws: if the database is down the
// header and footer still render from defaults.
const [{ settings, nav, blocks }, towns] = await Promise.all([
  getSiteChrome(Astro.locals),
  getTownsSafe(Astro.locals),
]);
const branding = await getBranding(settings);

const townContext = resolveTownContext(Astro.url, Astro.cookies, towns, pathTownSlug);

// Colours, fonts and sizes chosen on the admin Design page. Emitted as a
// style element, never a script, so the strict script-src policy holds.
const theme = resolveTheme(settings['theme.tokens']);
const themeStyles = themeCss(theme);
const googleFonts = fontHref(theme);

const siteName = (settings['site.name'] as string) || 'Pocket Perks';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? Astro.site?.href ?? '').replace(/\/$/, '');
const canonical = `${siteUrl}${canonicalPath ?? Astro.url.pathname}`.replace(/(.)\/$/, '$1');

const metaDescription =
  description ?? (settings['seo.default_description'] as string) ?? '';
const absolute = (url: string) => (/^https?:\/\//.test(url) ? url : `${siteUrl}${url.startsWith('/') ? '' : '/'}${url}`);
const shareImage = absolute(
  ogImage ?? branding.ogImage ?? ((settings['seo.og_image_path'] as string) || '/og-default.png')
);

const fullTitle = title.includes(siteName) ? title : `${title} — ${siteName}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  ...(settings['seo.default_description'] ? { description: settings['seo.default_description'] } : {}),
};

const breadcrumbSchema =
  breadcrumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: `${siteUrl}${c.href}`,
        })),
      }
    : null;

const allSchema = [organizationSchema, breadcrumbSchema, ...schema].filter(Boolean);

/**
 * JSON inside a script element must not contain "</script>", or any text a
 * business typed into their description could close the element and run as
 * code. Escaping "<" as < keeps the JSON identical and makes that
 * impossible.
 */
const safeJson = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={shareImage} />

    <meta name="theme-color" content="#093814" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={branding.favicon} type={branding.faviconType} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* The bundled pair, fetched early so headings and text appear in the
        right face straight away. Skipped if the Design page picked others. */}
    {!googleFonts && (
      <>
        <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
      </>
    )}

    {/* Only when the Design page has chosen a font other than the bundled
        pair. The default look makes no request to Google at all. */}
    {googleFonts && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={googleFonts} />
      </>
    )}

    {themeStyles && <style set:html={themeStyles} />}

    {allSchema.map((s) => (
      <script is:inline type="application/ld+json" set:html={safeJson(s)} />
    ))}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header nav={nav} settings={settings} blocks={blocks} branding={branding}
            towns={towns} townContext={townContext} />
    <main id="main" tabindex="-1">
      <slot />
      {signupBox && <div class="wrap signup-slot"><SignupBox source="page-bottom" /></div>}
    </main>
    <Footer nav={nav} settings={settings} branding={branding} blocks={blocks} towns={towns} />
    {/* Bundled by Astro: minified, fingerprinted, cached for a year, and
        always an external file, so script-src 'self' needs no exceptions. */}
    <script src="../scripts/site.js"></script>
  </body>
</html>

<style>
  .signup-slot { padding-block: var(--pp-space-6); }
</style>
