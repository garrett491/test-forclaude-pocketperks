---
import '../styles/global.css';
import '../styles/admin.css';
import type { PortalMe, PortalMerchant } from '../lib/portal';

/**
 * The business portal. Deliberately the same look as the admin, so one set
 * of styles serves both, but with only the pages a business may use.
 */
interface Props {
  title: string;
  me: PortalMe;
  merchant?: PortalMerchant | null;
}

const { title, me, merchant = null } = Astro.props;
const path = Astro.url.pathname;
const base = merchant ? `/portal/${merchant.slug}` : null;

const sections = base
  ? [
      { label: 'Coupons and changes', href: base },
      { label: 'Business details', href: `${base}/details` },
      { label: 'Opening hours', href: `${base}/hours` },
      { label: 'Photos', href: `${base}/photos` },
      { label: 'Report', href: `${base}/report` },
    ]
  : [];
const isCurrent = (href: string) =>
  href === base ? path === base || path.startsWith(`${base}/coupon`) : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Pocket Perks business login</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin-body portal-body">
    <a class="skip-link" href="#portal-main">Skip to content</a>

    <header class="admin-topbar">
      <a href="/portal" class="admin-brand">
        <img src="/logo.svg" alt="Pocket Perks" width="132" height="30" />
        <span class="admin-tag">Business</span>
      </a>
      <div class="admin-topbar-right">
        {merchant && <a href={`/b/${merchant.slug}`} target="_blank" rel="noopener" class="btn btn-ghost btn-sm">View your page</a>}
        <a href="/portal/account" class="admin-who">{me.display_name || me.email}</a>
        <form method="post" action="/portal/logout">
          <button class="btn btn-outline btn-sm" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <div class="admin-shell">
      <nav class="admin-nav" aria-label="Business portal">
        <ul class="list-plain">
          {me.merchants.length > 1 && (
            <li><a href="/portal" aria-current={path === '/portal' ? 'page' : undefined}>All your businesses</a></li>
          )}
          {merchant && <li class="nav-heading" aria-hidden="true">{merchant.name}</li>}
          {sections.map((s) => (
            <li><a href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>{s.label}</a></li>
          ))}
          <li><a href="/portal/account" aria-current={path === '/portal/account' ? 'page' : undefined}>Your account</a></li>
        </ul>
      </nav>

      <main id="portal-main" class="admin-main">
        <div class="admin-head">
          <h1>{title}</h1>
          <slot name="actions" />
        </div>
        <slot />
      </main>
    </div>
    <script src="../scripts/admin.js"></script>
  </body>
</html>

<style>
  .nav-heading {
    padding: var(--pp-space-3) var(--pp-space-3) var(--pp-space-1);
    font-size: var(--pp-text-xs); font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--pp-muted);
  }
  @media (max-width: 60rem) { .nav-heading { display: none; } }
  a.admin-who { text-decoration: none; }
  a.admin-who:hover { text-decoration: underline; }
</style>
