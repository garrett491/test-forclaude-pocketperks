# Browser-visible. Safe to publish: the anon role can read published
# content and write nothing, which the database tests prove.
PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJ..."
PUBLIC_SITE_URL="https://yourpocketperks.com"
PUBLIC_TURNSTILE_SITE_KEY=""

# Server only. Never prefix these PUBLIC_, never import them into a page
# or component, never log them. The service role bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=""
TURNSTILE_SECRET_KEY=""
SESSION_SALT=""

# Optional: email alerts for the business portal, sent through resend.com.
# Leave blank and nothing is emailed; the dashboard and portal still show
# everything. Server only, like the keys above.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL=""        # e.g. Pocket Perks <hello@yourpocketperks.com> (domain verified in Resend)
ADMIN_NOTIFY_EMAIL=""       # where "waiting for approval" alerts go; defaults to the contact email in Settings
